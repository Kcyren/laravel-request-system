* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Shell scripts and container config must keep LF endings (they run on Linux)
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
compose*.yaml text eol=lf
config-audit/* text eol=lf
