# =====================================================================
# MySQL container settings - TEMPLATE ONLY (Lab 4 / Lab 8)
# =====================================================================
# Copy to .env.db (git-ignored) and set strong, private values.
# MYSQL_USER is the dedicated application account; it receives privileges
# on MYSQL_DATABASE only (not global). Values must match DB_DATABASE,
# DB_USERNAME and DB_PASSWORD in .env.container / .env.staging.
# These values only take effect when the db_data volume is first created.

MYSQL_DATABASE=laravel_request_container_db
MYSQL_USER=lrs_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
