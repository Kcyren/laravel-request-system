# =====================================================================
# STAGING runtime settings - TEMPLATE ONLY (Lab 8 / Lab 9)
# =====================================================================
# Lives ONLY on the staging host as .env.staging (git-ignored, mode 600,
# owned by the deploy account). Provisioned through the approved runtime
# procedure - never committed, never baked into an image.
#
# APP_KEY: generate once for staging and KEEP IT across releases and
# rollbacks (changing it invalidates sessions and encrypted data).

APP_NAME="Laravel Request System"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.edu

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_staging_db
DB_USERNAME=lrs_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

APP_CONFIG_CACHE=true

SEED_STUDENT_PASSWORD=
SEED_ADMIN_PASSWORD=
