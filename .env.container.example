# =====================================================================
# App container runtime settings - TEMPLATE ONLY (Lab 4)
# =====================================================================
# Copy to .env.container (git-ignored) and fill in values privately:
#   cp .env.container.example .env.container
# Generate APP_KEY ONCE for this environment and keep it across container
# replacements:
#   docker compose run --rm --no-deps app php artisan key:generate --show
# (or locally: php artisan key:generate --show)

APP_NAME="Laravel Request System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# The MySQL service name on the private Compose network
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=lrs_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Cache config/routes/views at container start (entrypoint)
APP_CONFIG_CACHE=true

# Fictional seed-account passwords used by `php artisan db:seed` outside local
SEED_STUDENT_PASSWORD=
SEED_ADMIN_PASSWORD=
